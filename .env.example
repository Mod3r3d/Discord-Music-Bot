# --- Bắt buộc ---
DISCORD_TOKEN=your_discord_bot_token_here

# --- Tùy chọn: đồng bộ slash command nhanh vào 1 server khi test (để trống = sync global, mất ~1h để lan toả) ---
DEV_GUILD_ID=

# --- Tùy chọn: đường dẫn Deno runtime cho yt-dlp giải mã PO Token / JS challenge của YouTube ---
# Để trống nếu đã cài Deno vào PATH hệ thống.
DENO_PATH=

# --- Tùy chọn: đường dẫn tới cookies.txt (định dạng Netscape) để bypass 403 Forbidden ---
YTDLP_COOKIES_FILE=

# --- Tùy chọn: endpoint của PO Token Provider chạy nền (bgutils-ytdlp-pot-provider), ví dụ http://127.0.0.1:4416 ---
# Xem hướng dẫn triển khai trong README_V2.md mục "1.4"
POT_PROVIDER_URL=

# --- Tùy chọn: bật fallback SoundCloud khi YouTube trả 403 / bị chặn ---
ENABLE_SOUNDCLOUD_FALLBACK=true

# --- Tùy chọn: số giây chờ trước khi tự rời phòng voice khi không còn ai nghe ---
AUTO_DISCONNECT_SECONDS=60

# --- Tùy chọn: số giây trước khi bài hát kết thúc để bắt đầu pre-fetch bài kế tiếp ---
PREFETCH_LEAD_SECONDS=18
